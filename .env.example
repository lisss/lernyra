# Backend — SQLite by default for `make api` (no Docker).
# Docker Compose (`make up`) overrides this to Postgres automatically.
DATABASE_URL=sqlite:///./lernyra.db
# Postgres (compose / host connecting to published db port):
# DATABASE_URL=postgresql+psycopg://lernyra:lernyra@localhost:5432/lernyra

API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
REMOTIVE_ENABLED=true

YOUTUBE_API_KEY=
GOOGLE_BOOKS_API_KEY=
GITHUB_TOKEN=

# Frontend (Vite dev only). Docker serves UI from the API on :8000 (empty VITE_API_URL).
VITE_API_URL=http://localhost:8001
