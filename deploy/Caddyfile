# Canonical hostname (SEO). Set DOMAIN in .env, e.g. getbeacon.duckdns.org
{$DOMAIN} {
	encode gzip
	reverse_proxy api:8000
}

# Previous DuckDNS names → canonical (only names that still resolve)
getmedeina.duckdns.org {
	redir https://{$DOMAIN}{uri} permanent
}

pathquire.duckdns.org {
	redir https://{$DOMAIN}{uri} permanent
}

getcast.duckdns.org {
	redir https://{$DOMAIN}{uri} permanent
}
